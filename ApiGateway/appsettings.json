{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "Issuer": "https://your-auth-server.com",
    "Audience": "api-gateway",
    "SecretKey": "CHANGE_ME_super_long_secret_key_at_least_32_chars!"
  },

  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "debug-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/debug/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "dead-route": {
        "ClusterId": "dead-cluster",
        "Match": {
          "Path": "/api/dead/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous"
      }
    },
    "Clusters": {
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "node1": { "Address": "http://localhost:5100" }
        }
      },
      "users-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "node1": { "Address": "http://localhost:5100" }
        }
      },
      "inventory-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "node1": { "Address": "http://localhost:5100" },
          "node2": { "Address": "http://localhost:5100" }
        }
      },
      "dead-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "node1": { "Address": "http://localhost:5199" }
        }
      }
    }
  }
}
